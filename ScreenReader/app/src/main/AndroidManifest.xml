<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The reading controls notification (Back / Pause / Skip / Stop). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- So the app can see the text-to-speech engine's installed voices. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- "Open & read" opens Sabbath School or any app the user picks from the list of apps. -->
        <package android:name="com.cryart.sabbathschool" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ZYLENA Screen Reader"
        android:theme="@style/Zylena">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <!-- The tile opens this invisible screen so the panel closes, then the service reads what is behind it. -->
        <activity
            android:name=".ReadNowActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ReadTileService"
            android:exported="true"
            android:icon="@drawable/ic_speaker"
            android:label="Read screen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ReadClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_speaker"
            android:label="Read copied text"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Tells the reader when the app is swiped away from recent apps, so it closes too. -->
        <service
            android:name=".TaskWatch"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name=".ReaderService"
            android:exported="true"
            android:label="@string/reader_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/reader_service" />
        </service>
    </application>
</manifest>
